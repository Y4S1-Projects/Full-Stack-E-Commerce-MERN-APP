{
  "info": {
    "name": "Security Vulnerability Assessment - Before/After Comparison",
    "description": "Comprehensive testing collection to demonstrate security improvements in MERN E-Commerce application",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "🔍 SECURITY HEADERS VERIFICATION",
      "item": [
        {
          "name": "1. Backend API - Security Headers Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Test for Content Security Policy Header",
                  "pm.test('✅ CSP Header is Present', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Security-Policy')).to.not.be.null;",
                  "});",
                  "",
                  "// Test for X-Frame-Options Header",
                  "pm.test('✅ X-Frame-Options Header is Present', function () {",
                  "    pm.expect(pm.response.headers.get('X-Frame-Options')).to.not.be.null;",
                  "});",
                  "",
                  "// Test CSP does not contain unsafe-inline in style-src",
                  "pm.test('✅ CSP style-src does NOT contain unsafe-inline', function () {",
                  "    const csp = pm.response.headers.get('Content-Security-Policy');",
                  "    pm.expect(csp).to.not.include(\"'unsafe-inline'\");",
                  "});",
                  "",
                  "// Test X-Frame-Options is set to DENY",
                  "pm.test('✅ X-Frame-Options is set to DENY', function () {",
                  "    pm.expect(pm.response.headers.get('X-Frame-Options')).to.include('DENY');",
                  "});",
                  "",
                  "// Additional Security Headers Check",
                  "pm.test('✅ Additional Security Headers Present', function () {",
                  "    pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.not.be.null;",
                  "    pm.expect(pm.response.headers.get('Referrer-Policy')).to.not.be.null;",
                  "});",
                  "",
                  "// Log all security-related headers for documentation",
                  "console.log('=== SECURITY HEADERS ANALYSIS ===');",
                  "console.log('Content-Security-Policy:', pm.response.headers.get('Content-Security-Policy'));",
                  "console.log('X-Frame-Options:', pm.response.headers.get('X-Frame-Options'));",
                  "console.log('X-Content-Type-Options:', pm.response.headers.get('X-Content-Type-Options'));",
                  "console.log('Referrer-Policy:', pm.response.headers.get('Referrer-Policy'));",
                  "console.log('==================================');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/test",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "test"]
            }
          }
        },
        {
          "name": "2. Frontend Application - Security Headers Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Test frontend security headers",
                  "pm.test('🌐 Frontend CSP Header Check', function () {",
                  "    const csp = pm.response.headers.get('Content-Security-Policy');",
                  "    if (csp) {",
                  "        pm.expect(csp).to.include(\"style-src 'self'\");",
                  "        pm.expect(csp).to.include('https://fonts.googleapis.com');",
                  "        console.log('Frontend CSP:', csp);",
                  "    } else {",
                  "        console.log('Frontend CSP not found in response headers');",
                  "    }",
                  "});",
                  "",
                  "pm.test('🌐 Frontend X-Frame-Options Check', function () {",
                  "    const xFrame = pm.response.headers.get('X-Frame-Options');",
                  "    if (xFrame) {",
                  "        pm.expect(xFrame).to.include('DENY');",
                  "        console.log('Frontend X-Frame-Options:', xFrame);",
                  "    } else {",
                  "        console.log('Frontend X-Frame-Options not found');",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": [""]
            }
          }
        }
      ]
    },
    {
      "name": "📊 VULNERABILITY STATUS VERIFICATION",
      "item": [
        {
          "name": "1. CSP Header Not Set - VERIFICATION",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// VULNERABILITY: Content Security Policy Header Not Set",
                  "// STATUS: SHOULD BE FIXED ✅",
                  "",
                  "pm.test('🔒 VULNERABILITY FIXED: CSP Header is Present', function () {",
                  "    const csp = pm.response.headers.get('Content-Security-Policy');",
                  "    pm.expect(csp).to.not.be.null;",
                  "    pm.expect(csp).to.not.be.undefined;",
                  "    pm.expect(csp.length).to.be.greaterThan(0);",
                  "});",
                  "",
                  "pm.test('🔒 CSP Contains Required Directives', function () {",
                  "    const csp = pm.response.headers.get('Content-Security-Policy');",
                  "    pm.expect(csp).to.include('default-src');",
                  "    pm.expect(csp).to.include('style-src');",
                  "    pm.expect(csp).to.include('script-src');",
                  "    pm.expect(csp).to.include('img-src');",
                  "});",
                  "",
                  "// Document the fix",
                  "console.log('🎉 VULNERABILITY STATUS: CSP Header Not Set - RESOLVED');",
                  "console.log('📋 Evidence: CSP Header Present and Configured');",
                  "console.log('🔧 Implementation: Helmet.js with comprehensive directives');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/test",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "test"]
            }
          }
        },
        {
          "name": "2. X-Frame-Options Not Set - VERIFICATION",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// VULNERABILITY: X-Frame-Options Header Not Set",
                  "// STATUS: SHOULD BE FIXED ✅",
                  "",
                  "pm.test('🔒 VULNERABILITY FIXED: X-Frame-Options Header Present', function () {",
                  "    const xFrame = pm.response.headers.get('X-Frame-Options');",
                  "    pm.expect(xFrame).to.not.be.null;",
                  "    pm.expect(xFrame).to.not.be.undefined;",
                  "});",
                  "",
                  "pm.test('🔒 X-Frame-Options Set to DENY (Secure)', function () {",
                  "    const xFrame = pm.response.headers.get('X-Frame-Options');",
                  "    pm.expect(xFrame).to.include('DENY');",
                  "});",
                  "",
                  "// Document the fix",
                  "console.log('🎉 VULNERABILITY STATUS: X-Frame-Options Not Set - RESOLVED');",
                  "console.log('📋 Evidence: X-Frame-Options: DENY header present');",
                  "console.log('🔧 Implementation: Helmet.js frameguard configuration');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/test",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "test"]
            }
          }
        },
        {
          "name": "3. CSP unsafe-inline Usage - VERIFICATION",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// VULNERABILITY: CSP 'unsafe-inline' Usage in Style Sources",
                  "// STATUS: SHOULD BE FIXED ✅",
                  "",
                  "pm.test('🔒 VULNERABILITY FIXED: No unsafe-inline in style-src', function () {",
                  "    const csp = pm.response.headers.get('Content-Security-Policy');",
                  "    pm.expect(csp).to.not.include(\"'unsafe-inline'\");",
                  "});",
                  "",
                  "pm.test('🔒 Secure Style Sources Only', function () {",
                  "    const csp = pm.response.headers.get('Content-Security-Policy');",
                  "    pm.expect(csp).to.include(\"style-src 'self'\");",
                  "    pm.expect(csp).to.include('https://fonts.googleapis.com');",
                  "});",
                  "",
                  "pm.test('🔒 No Unsafe Script Directives', function () {",
                  "    const csp = pm.response.headers.get('Content-Security-Policy');",
                  "    pm.expect(csp).to.include(\"script-src 'self'\");",
                  "    // Allow unsafe-eval only for development webpack",
                  "    if (csp.includes(\"'unsafe-eval'\")) {",
                  "        console.log('⚠️  Note: unsafe-eval present (development webpack requirement)');",
                  "    }",
                  "});",
                  "",
                  "// Document the fix",
                  "console.log('🎉 VULNERABILITY STATUS: CSP unsafe-inline Usage - RESOLVED');",
                  "console.log('📋 Evidence: style-src directive contains no unsafe-inline');",
                  "console.log('🔧 Implementation: CSS refactoring with custom properties');",
                  "console.log('🎨 Solution: Inline styles converted to secure CSS classes');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/test",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "test"]
            }
          }
        }
      ]
    },
